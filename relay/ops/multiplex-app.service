[Unit]
Description=multiplex web relay (PC-hosted muxd terminal mirror)
After=network.target

[Service]
Type=simple
User=svc-multiplex
Group=svc-multiplex
SupplementaryGroups=
WorkingDirectory=/opt/multiplex-app
EnvironmentFile=/etc/multiplex-app.env
Environment=MUX_STATE_DIR=/var/lib/multiplex
Environment=HOME=/var/lib/multiplex
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/multiplex-app/server.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077

StateDirectory=multiplex
StateDirectoryMode=0700
ReadWritePaths=/var/lib/multiplex
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=no
DevicePolicy=closed
ProtectProc=invisible
ProcSubset=pid
TasksMax=512

[Install]
WantedBy=multi-user.target
