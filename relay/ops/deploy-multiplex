#!/usr/bin/env bash
# Root-owned fixed-policy installer. The caller supplies content identity, never paths or commands.
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

die() { printf 'deploy-multiplex: %s\n' "$*" >&2; exit 1; }
log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a /var/log/multiplex-deploy.log; }

[ "$(id -u)" -eq 0 ] || die "must run as root"
RELEASES=/opt/multiplex-releases
CURRENT=/opt/multiplex-app
STATE=/var/lib/multiplex
UNIT=multiplex-app.service
ENV_FILE=/etc/multiplex-app.env

require_unit_value() {
    local property="$1" expected="$2" actual
    actual="$(systemctl show "$UNIT" -p "$property" --value)"
    [ "$actual" = "$expected" ] || die "$UNIT must have $property=$expected (found ${actual:-<empty>})"
}

runtime_identity_ok() {
    local pid status svc_uid svc_gid docker_gid
    pid="$(systemctl show "$UNIT" -p MainPID --value)"
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    status="/proc/$pid/status"
    [ -r "$status" ] || return 1
    svc_uid="$(id -u svc-multiplex)"
    svc_gid="$(id -g svc-multiplex)"
    awk -v expected="$svc_uid" '
        /^Uid:/ {
            found = 1
            for (i = 2; i <= 5; i++) if ($i != expected) exit 1
        }
        END { if (!found) exit 1 }
    ' "$status" || return 1
    awk -v expected="$svc_gid" '
        /^Gid:/ {
            found = 1
            for (i = 2; i <= 5; i++) if ($i != expected) exit 1
        }
        END { if (!found) exit 1 }
    ' "$status" || return 1
    docker_gid="$(getent group docker | awk -F: '{print $3; exit}')"
    if [ -n "$docker_gid" ] && awk -v denied="$docker_gid" '
        /^Groups:/ {
            for (i = 2; i <= NF; i++) if ($i == denied) found = 1
        }
        END { exit(found ? 0 : 1) }
    ' "$status"; then
        return 1
    fi
}

env_has_value() {
    local key="$1"
    awk -F= -v key="$key" '
        $1 == key {
            value = substr($0, index($0, "=") + 1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            if (value != "" && value != "\"\"" && value != "\047\047") found = 1
        }
        END { exit(found ? 0 : 1) }
    ' "$ENV_FILE"
}

preflight() {
    local env_mode env_owner env_group listeners
    [ -f "$ENV_FILE" ] && [ ! -L "$ENV_FILE" ] || die "$ENV_FILE is missing or unsafe"
    env_owner="$(stat -c %U "$ENV_FILE")"
    env_group="$(stat -c %G "$ENV_FILE")"
    env_mode="$(stat -c %a "$ENV_FILE")"
    [ "$env_owner:$env_group" = "root:root" ] || die "$ENV_FILE must be owned by root:root"
    [ "$env_mode" = 600 ] || die "$ENV_FILE must have mode 0600"
    for key in PORT MUX_HOST_TOKEN HL_INTERNAL_KEY MUX_COMMAND_BRIDGE_TOKEN; do
        env_has_value "$key" || die "$ENV_FILE is missing a non-empty $key"
    done
    # Both halves of the command-bridge credential, or the PC can never drain the queue. The server
    # half alone is the failure that matters: with the env value present but the header file missing
    # or mis-shaped, every lease attempt exits 77 before curl runs and the web sees a 30s timeout on
    # every Start-chat / Resume with no server-side error at all. Check the file with the SAME
    # predicate the consumer applies, so "preflight ok" means the PC's guard would pass too.
    hdr="/home/$(id -un harmonizer)/.config/mux/command-bridge.header"
    if [ ! -f "$hdr" ] || [ -L "$hdr" ] || [ ! -s "$hdr" ] || [ ! -r "$hdr" ]; then
        die "$hdr is missing or unsafe (the PC command consumer needs it)"
    fi
    [ "$(stat -c %u "$hdr")" = "$(id -u harmonizer)" ] ||
        die "$hdr must be owned by the harmonizer account the PC's ssh route authenticates as"
    case "$(stat -c %A "$hdr")" in
        ?r??------) ;;
        *) die "$hdr must be mode 0400/0500/0600 (owner read only), as the consumer requires" ;;
    esac
    # MUX_BRIDGE_TOKEN is optional, and the relay fails CLOSED without it: the archive-index routes
    # stay 403. No PC-side producer ships in this tree, so requiring it would gate every deploy on a
    # credential nothing exercises. Warn rather than die, so an absent capability stays visible.
    env_has_value MUX_BRIDGE_TOKEN ||
        log "MUX_BRIDGE_TOKEN absent; relay archive-index routes stay closed (no producer in this tree)"

    require_unit_value User svc-multiplex
    require_unit_value Group svc-multiplex
    require_unit_value NoNewPrivileges yes
    require_unit_value ProtectSystem strict
    require_unit_value ReadWritePaths /var/lib/multiplex
    require_unit_value SupplementaryGroups ""
    if systemctl is-active --quiet "$UNIT"; then
        runtime_identity_ok || die "$UNIT running process has the wrong UID/GID or retains docker access"
    fi

    nginx -t >/dev/null 2>&1 || die "nginx configuration check failed"
    listeners="$(ss -H -ltn 'sport = :4200' | awk '{print $4}')"
    [ -n "$listeners" ] || die "hl-auth is not listening on port 4200"
    if printf '%s\n' "$listeners" | grep -Ev '^(127\.0\.0\.1|\[::1\]):4200$' >/dev/null; then
        die "hl-auth port 4200 must be loopback-only"
    fi
}

if [ "$#" -eq 1 ] && [ "$1" = --preflight ]; then
    preflight
    printf 'deploy-multiplex preflight ok\n'
    exit 0
fi

[ "$#" -eq 2 ] || die "usage: deploy-multiplex --preflight | <40-hex-commit> <64-hex-sha256>"
COMMIT="$1"
EXPECTED_SHA="$2"
[[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]] || die "invalid commit"
[[ "$EXPECTED_SHA" =~ ^[0-9a-f]{64}$ ]] || die "invalid sha256"
preflight

ARCHIVE="/home/admin/multiplex-incoming/multiplex-$COMMIT.tgz"
[ -f "$ARCHIVE" ] && [ ! -L "$ARCHIVE" ] || die "release archive missing or unsafe"
[ "$(stat -c %U "$ARCHIVE")" = admin ] || die "release archive must be owned by admin"
QUARANTINE="$STATE/deploy-incoming"
install -d -o root -g root -m 0700 "$QUARANTINE"
mv -- "$ARCHIVE" "$QUARANTINE/multiplex-$COMMIT.tgz"
ARCHIVE="$QUARANTINE/multiplex-$COMMIT.tgz"
[ -f "$ARCHIVE" ] && [ ! -L "$ARCHIVE" ] || die "quarantined release archive is unsafe"
ACTUAL_SHA="$(sha256sum "$ARCHIVE" | awk '{print $1}')"
[ "$ACTUAL_SHA" = "$EXPECTED_SHA" ] || die "release archive checksum mismatch"

STAGE="$(mktemp -d /opt/multiplex-stage.XXXXXX)"
NEXT_LINK=/opt/.multiplex-app.next
cleanup() { rm -rf -- "$STAGE" "$NEXT_LINK"; }
trap cleanup EXIT

python3 - "$ARCHIVE" "$STAGE" <<'PY'
import pathlib, sys, tarfile
archive, stage = sys.argv[1:]
root = pathlib.Path(stage).resolve()
with tarfile.open(archive, "r:gz") as tf:
    for member in tf.getmembers():
        path = pathlib.PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts:
            raise SystemExit("unsafe archive path: " + member.name)
        if not (member.isdir() or member.isfile()):
            raise SystemExit("archive links/devices are refused: " + member.name)
        target = (root / pathlib.Path(*path.parts)).resolve()
        if root not in target.parents and target != root:
            raise SystemExit("archive path escapes staging: " + member.name)
    tf.extractall(root)
PY

[ "$(cat "$STAGE/RELEASE_COMMIT")" = "$COMMIT" ] || die "archive commit marker mismatch"
APP="$STAGE/relay"
[ -f "$APP/server.js" ] || die "release is missing relay/server.js"
[ -f "$APP/package.json" ] && [ -f "$APP/package-lock.json" ] || die "release is missing npm manifests"
[ -f "$STAGE/scripts/backup-state.sh" ] || die "release is missing backup-state.sh"

install -d -o svc-multiplex -g svc-multiplex -m 0700 "$STATE"
chown -R svc-multiplex:svc-multiplex "$STAGE"
runuser -u svc-multiplex -- env HOME="$STATE" npm --prefix "$APP" ci --omit=dev --ignore-scripts
runuser -u svc-multiplex -- node --check "$APP/server.js"
chown -R root:root "$STAGE"
chmod -R go-w "$STAGE"
# `mktemp -d` creates the stage 0700, and `go-w` cannot widen it. Without this the release directory
# reaches root-owned but untraversable, so the service account cannot read /opt/multiplex-app after
# the swap and the health gate only discovers it by rolling back.
chmod 0755 "$STAGE" "$STAGE/relay"

RELEASE="$RELEASES/$COMMIT"
install -d -o root -g root -m 0755 "$RELEASES"
if [ -e "$RELEASE" ]; then
    [ -f "$RELEASE/RELEASE_COMMIT" ] && [ "$(cat "$RELEASE/RELEASE_COMMIT")" = "$COMMIT" ] \
        || die "existing release directory does not match commit"
    rm -rf -- "$STAGE"
else
    mv -- "$STAGE" "$RELEASE"
fi
chmod 0755 "$RELEASE" "$RELEASE/relay"

install -o root -g root -m 0755 "$RELEASE/scripts/backup-state.sh" /usr/local/bin/mux-backup-state.sh

PREVIOUS=""
LEGACY=""
if [ -L "$CURRENT" ]; then
    PREVIOUS="$(readlink -f "$CURRENT")"
elif [ -d "$CURRENT" ]; then
    LEGACY="$RELEASES/legacy-$(date -u +%Y%m%dT%H%M%SZ)"
fi

PORT="$(awk -F= '$1 == "PORT" { gsub(/[[:space:]]/, "", $2); print $2; exit }' "$ENV_FILE")"
[[ "$PORT" =~ ^[0-9]{2,5}$ ]] || die "invalid PORT in $ENV_FILE"

# Read the body into a variable BEFORE parsing it. The old form piped curl straight into python3, so
# every poll taken while the relay was down handed the parser an empty stdin, and the traceback it
# raised (`JSONDecodeError`) was written to stderr on every iteration - noise on exactly the output a
# real failure has to stay legible through. Passing the body as an argument removes stdin from the
# path, and the parse itself is total: a 200 that is not the JSON we expect returns 1 quietly instead
# of raising. Curl's own exit status is still the first verdict (pipefail would have caught it, but
# `|| return 1` states it).
release_health_ok() {
    local body
    runtime_identity_ok || return 1
    body="$(curl -fsS --max-time 3 "http://127.0.0.1:$PORT/api/health")" || return 1
    python3 -c '
import json, sys
try:
    health = json.loads(sys.argv[1])
except ValueError:
    raise SystemExit(1)
if not isinstance(health, dict):
    raise SystemExit(1)
persistence = health.get("persistence") or {}
ok = (
    isinstance(health.get("uptimeSec"), (int, float))
    and isinstance(health.get("node"), str)
    and bool(health.get("node"))
    and persistence.get("ok") is True
)
raise SystemExit(0 if ok else 1)
' "$body"
}

distributed_health_ok() {
    local body
    body="$(curl -fsS --max-time 3 "http://127.0.0.1:$PORT/api/health")" || return 1
    python3 -c '
import json, sys
try:
    ok = json.loads(sys.argv[1]).get("ok") is True
except (ValueError, AttributeError):
    ok = False
raise SystemExit(0 if ok else 1)
' "$body"
}

# The remote command is `exit 0`, not `true`: the PC runs Windows OpenSSH with a non-POSIX login
# shell - measured 2026-09-16, OpenSSH's registry DefaultShell hands the connection PowerShell 5.1 -
# where `true` is not a command at all and exits 1. A probe that always fails meant this gate never
# passed, so the backup timer was never enabled and the route was never actually exercised.
#
# -F names the route file explicitly. ssh reads its per-user config from the account's PASSWD home,
# not from $HOME, and svc-multiplex's passwd home (/home/svc-multiplex) does not exist - so without
# this the `Host win` alias never applied and the probe failed on "Could not resolve hostname win"
# no matter how correct the key and known_hosts were. HOME is still exported for the child.
backup_route_ready() {
    runuser -u svc-multiplex -- env HOME="$STATE" \
        ssh -F "$STATE/.ssh/config" -o BatchMode=yes -o ConnectTimeout=5 \
        -o StrictHostKeyChecking=yes -o RequestTTY=no -n win exit 0 \
        >/dev/null 2>&1
}

# `systemctl stop` exits non-zero when systemd CANCELS the stop job rather than performing it, and a
# cancel is not a failure to stop - the unit is still running. Measured 2026-09-21: the healthcheck
# timer's tick activated multiplex-healthcheck.service inside the drain window, its Wants= queued a
# start for multiplex-app.service, systemd canceled the pending stop, and `set -e` aborted this script
# AFTER the release had been staged but BEFORE the symlink swap - so the relay silently kept serving
# the old code and the only signal was "Job for multiplex-app.service canceled.". The unit no longer
# pulls the app in (that is the actual fix), but a deploy must not stake its correctness on another
# unit's definition staying right: retry, then judge by the observed state, never by the exit status.
# Non-fatal by design, so the rollback path can call it without masking the failure that caused it.
stop_unit() {
    local attempt out
    for attempt in 1 2 3; do
        if out="$(systemctl stop "$UNIT" 2>&1)"; then
            return 0
        fi
        log "stop of $UNIT was refused (attempt $attempt): ${out:-<no output>}"
        sleep 2
    done
    if systemctl is-active --quiet "$UNIT"; then
        return 1
    fi
    return 0
}

# The old gate polled 40 times at 0.5 s - a 20 s budget against a start-to-listen that measured 0, 0,
# 6, 16 and 30 s across the last five live starts. That is not a safety margin, it is a coin flip, and
# its losing side rolls back a release that was never broken. Wait on a budget that covers the worst
# observed start (and stays inside the unit's own 90 s start timeout), and stop early once the unit
# has actually failed so a real failure is reported in seconds rather than after the whole budget.
HEALTH_WAIT_SECS=90
wait_for_release_health() {
    local started=$SECONDS deadline=$((SECONDS + HEALTH_WAIT_SECS)) elapsed
    while :; do
        if release_health_ok; then
            elapsed=$((SECONDS - started))
            if [ "$elapsed" -gt 5 ]; then
                log "wait: health green after ${elapsed}s"
            fi
            return 0
        fi
        if systemctl is-failed --quiet "$UNIT"; then
            log "wait: $UNIT entered the failed state after $((SECONDS - started))s; not waiting further"
            return 1
        fi
        if [ "$SECONDS" -ge "$deadline" ]; then
            log "wait: health not green after ${HEALTH_WAIT_SECS}s"
            return 1
        fi
        sleep 0.5
    done
}

log "deploy start commit=$COMMIT sha256=$EXPECTED_SHA"
stop_unit || die "$UNIT would not stop; refusing to swap the release under a running process"
if [ -n "$LEGACY" ]; then
    mv -- "$CURRENT" "$LEGACY"
    PREVIOUS="$LEGACY"
fi
ln -s "$RELEASE/relay" "$NEXT_LINK"
mv -Tf -- "$NEXT_LINK" "$CURRENT"

if systemctl start "$UNIT"; then
    wait_for_release_health || true
fi

if ! systemctl is-active --quiet "$UNIT" || ! release_health_ok; then
    log "deploy health failed commit=$COMMIT; rolling back"
    stop_unit || log "rollback: $UNIT would not stop; the restored symlink may not take effect until it restarts"
    if [ -n "$PREVIOUS" ] && [ -d "$PREVIOUS" ]; then
        ln -s "$PREVIOUS" "$NEXT_LINK"
        mv -Tf -- "$NEXT_LINK" "$CURRENT"
        systemctl start "$UNIT"
        wait_for_release_health || true
    fi
    release_health_ok || die "deployment and rollback health checks failed"
    die "deployment failed; previous release restored"
fi

if distributed_health_ok; then
    log "distributed health green commit=$COMMIT"
else
    log "deploy locally healthy commit=$COMMIT; distributed health remains degraded"
fi

if backup_route_ready; then
    if systemctl enable --now mux-relay-backup.timer; then
        log "backup timer enabled; svc-multiplex win route verified"
    else
        log "backup route verified, but timer activation failed; application release remains healthy"
    fi
elif systemctl is-enabled --quiet mux-relay-backup.timer; then
    log "backup route unavailable; existing timer remains enabled and will skip cleanly"
else
    log "backup timer left disabled; svc-multiplex win route is not ready"
fi
rm -f -- "$ARCHIVE"
log "deploy healthy commit=$COMMIT"
