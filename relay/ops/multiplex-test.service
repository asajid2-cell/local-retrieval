[Unit]
Description=multiplex parallel relay test endpoint
After=network.target

[Service]
Type=simple
User=svc-multiplex-test
Group=svc-multiplex-test
SupplementaryGroups=
WorkingDirectory=/opt/multiplex-test-app
EnvironmentFile=/etc/multiplex-test.env
Environment=MUX_STATE_DIR=/var/lib/multiplex-test
Environment=HOME=/var/lib/multiplex-test
Environment=PORT=7683
Environment=BIND_HOST=127.0.0.1
Environment=PUBLIC_RETURN=/multiplex-test
Environment=MUX_HOST_PROFILE=test
Environment=NODE_ENV=production
ExecStartPre=+/usr/local/bin/multiplex-test-config-check
ExecStart=/usr/bin/node /opt/multiplex-test-app/server.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077

StateDirectory=multiplex-test
StateDirectoryMode=0700
ReadWritePaths=/var/lib/multiplex-test
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=no
DevicePolicy=closed
ProtectProc=invisible
ProcSubset=pid
TasksMax=512

[Install]
WantedBy=multi-user.target
