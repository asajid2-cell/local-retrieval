[Unit]
Description=Back up multiplex relay durable state off-box to the PC
Documentation=file:///opt/multiplex-app/ops/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=svc-multiplex
Group=svc-multiplex
Environment=HOME=/var/lib/multiplex

# A temporary PC outage or unconfigured service-user SSH route skips this run
# without turning the oneshot into a failed unit. The deploy wrapper enables the
# timer only after the same strict probe has succeeded at least once.
#
# The remote command must be one every plausible remote shell understands, because
# the PC runs Windows OpenSSH with cmd.exe as the shell (sshd_config sets no
# DefaultShell). The first revision sent `true`, which cmd reports as "'true' is not
# recognized as an internal or external command" and exits 1 — so this condition was
# false on every tick, the unit was skipped, and `mux-relay-backup.service` had no
# journal entries at all. `exit 0` is a builtin in cmd, in POSIX sh, and in
# PowerShell, so the probe tests the ROUTE and not the remote shell's dialect.
#
# -F is not decoration. ssh takes its per-user config from the account's PASSWD home,
# not from $HOME (which this unit sets), and svc-multiplex's passwd home does not
# exist - so without it the `Host win` alias never resolved and the probe failed on
# "Could not resolve hostname win" however correct the key and known_hosts were.
# ProtectHome=yes below is the other half of why the route cannot simply live in /home.
ExecCondition=/usr/bin/ssh -F /var/lib/multiplex/.ssh/config -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=yes -o RequestTTY=no -n win exit 0

# --verify proves a restore roundtrip against the freshly built archive BEFORE it is
# sent, so a corrupt or empty backup fails the unit instead of silently replacing a
# good one on the far side.
ExecStart=/usr/local/bin/mux-backup-state.sh --state-dir /var/lib/multiplex --verify

# The script builds its archive under TMPDIR and refuses to include anything outside
# its allowlist, so it needs no write access to the relay's state dir.
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadOnlyPaths=/var/lib/multiplex
ProtectHome=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
TasksMax=128

# A failed backup is not an emergency, but it must be visible.
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
