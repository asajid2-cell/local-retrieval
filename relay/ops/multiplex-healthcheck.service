[Unit]
Description=Multiplex relay healthcheck
Documentation=http://127.0.0.1:7682/api/health
# No Wants=/Requires= on multiplex-app.service, deliberately, and After= must not name it either.
# Wants= is not a passive declaration: activating this unit queues a START for multiplex-app.service,
# and when that lands inside a deploy's drain window systemd CANCELS the deploy's pending stop job.
# `systemctl stop` then exits non-zero, `set -euo pipefail` aborts deploy-multiplex after the release
# has been staged but before the symlink swap, and the relay silently keeps running the old code.
# Measured 2026-09-21 on the 028bfad deploy: "Job for multiplex-app.service canceled." and nothing
# else anywhere. A monitor must never be able to start the thing it monitors.
After=network-online.target

[Service]
Type=oneshot
# harmonizer, not root: this unit only reads /api/health over loopback. It needs no privilege, and a
# read-only probe is exactly the kind of thing tier 1 is allowed to hold.
User=harmonizer
Group=harmonizer
# PORT is the relay's bind port (server.js: `+process.env.PORT || 7682`). Keep this in step with the
# service's EnvironmentFile; a stale port here reads as "relay down" while the relay is fine.
Environment=MULTIPLEX_HEALTH_URL=http://127.0.0.1:7682/api/health
Environment=MULTIPLEX_MIN_NODE_MAJOR=20
Environment=MULTIPLEX_HEALTH_TIMEOUT_MS=5000
ExecStart=/usr/local/bin/multiplex-healthcheck
