<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- WMI (System.Management) is Windows-only; this app only ever runs on the Windows PC, so the
         platform-compatibility analyzer warning is moot. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodexLocalRetrieval.Native.Tests" />
    <!-- The server is the archive's unattended host: it needs the same diagnostic seams the GUI has
         (SavePhaseMeasured), which are internal so they stay out of the public surface. -->
    <InternalsVisibleTo Include="CodexLocalRetrieval.Server" />
  </ItemGroup>

</Project>
